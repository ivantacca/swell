[Desktop Entry]
Version=1.0
Type=Application
Name=Swell
GenericName=Web Browser
Comment=Browse with fully isolated spaces in one window
Exec="@EXEC@" %u
Icon=swell
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=swell
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec="@EXEC@" --new-window
